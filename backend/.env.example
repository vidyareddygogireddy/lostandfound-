# Backend Environment Variables Template

# Server Port (Default: 8080)
PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/laf?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_mysql_username
SPRING_DATASOURCE_PASSWORD=your_mysql_password

# Hibernate / JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Security & JWT Secret (Generate a strong 256-bit secret for production)
JWT_SECRET=94a08da1fecbb6e8b46990538c7b50b240ce4d93e78df794bdf34a5d4a13e2e0
JWT_EXPIRATION=86400000

# File Upload Directory
UPLOAD_DIR=uploads
